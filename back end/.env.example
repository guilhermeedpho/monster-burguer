# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env (ele já está no .gitignore).

DATABASE_URL="postgresql://usuario:senha@localhost:5432/monster_burguer"

# URL(s) do front-end autorizadas a acessar a API (separadas por vírgula).
FRONTEND_URL="http://localhost:5173"

# development | production
NODE_ENV="development"

# true para logar todas as queries SQL mesmo em produção
LOG_QUERIES="false"

# Taxa de erro (0 a 1) que dispara um alerta. 0.2 = 20%.
ALERT_ERROR_RATE_THRESHOLD="0.2"

# Opcional: URL de webhook (Slack/Discord) pra receber alertas.
ALERT_WEBHOOK_URL=""

# Segredo pra assinar os tokens de login (JWT). Gere um valor forte, ex.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Só use true quando a API estiver atrás de um proxy reverso confiável
# (ex.: Nginx/Cloudflare). Deixe false por padrão.
TRUST_PROXY="false"
